---
import { getCollection } from 'astro:content';
import { collectTodos, ideaExcerpt, isIdea } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allNotes = await getCollection('notes');
const notes = allNotes
  .filter((note) => !note.data.series && !isIdea(note.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const ideaItems = allNotes
  .filter((note) => isIdea(note.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((note) => ({
    note,
    excerpt: ideaExcerpt(note.body),
  }));

const todoItems = collectTodos(allNotes);

function ym(d: Date) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  return `${y}-${m}`;
}

function ymd(d: Date) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

const groups = new Map<string, typeof notes>();
for (const n of notes) {
  const key = ym(n.data.date);
  const list = groups.get(key) ?? [];
  list.push(n);
  groups.set(key, list);
}
---

<BaseLayout title="目录">
  <div class="board-row">
    <section class="board">
      <header class="board-toolbar">
        <h2>Idea</h2>
        <div class="board-toolbar-actions">
          <span>未完成</span>
          <span class="board-count">{ideaItems.length}</span>
        </div>
      </header>
      {
        ideaItems.length ? (
          <ul class="idea-list" tabindex="-1">
            {ideaItems.map(({ note, excerpt }) => (
              <li>
                <a class="idea-title" href={`/notes/${note.id}/`}>
                  {note.data.title}
                </a>
                <time class="todo-date" datetime={note.data.date.toISOString()}>
                  {ymd(note.data.date)}
                </time>
                {excerpt && <p class="idea-body">{excerpt}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="board-empty">暂无 idea</p>
        )
      }
    </section>
    <section class="board">
      <header class="board-toolbar">
        <h2>Todo</h2>
        <div class="board-toolbar-actions">
          <span>未完成</span>
          <span class="board-count">{todoItems.length}</span>
        </div>
      </header>
      {
        todoItems.length ? (
          <ul class="todo-list" tabindex="-1">
            {todoItems.map((item) => (
              <li>
                {item.href ? (
                  <a class="todo-title" href={item.href}>
                    {item.title}
                  </a>
                ) : (
                  <p class="todo-title">{item.title}</p>
                )}
                {item.remark && <p class="todo-remark">{item.remark}</p>}
                <time class="todo-date" datetime={item.date.toISOString()}>
                  {ymd(item.date)}
                </time>
              </li>
            ))}
          </ul>
        ) : (
          <p class="board-empty">没有未完成的 todo</p>
        )
      }
    </section>
  </div>
  <h1 class="month">目录</h1>
  {
    [...groups.entries()].map(([month, items]) => (
      <section>
        <h2 class="month">{month}</h2>
        <ul class="note-list">
          {items.map((n) => (
            <li>
              <time datetime={n.data.date.toISOString()}>{ymd(n.data.date)}</time>
              <a href={`/notes/${n.id}/`}>{n.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <script>
    const resetBoardFocus = () => {
      const active = document.activeElement;
      if (active instanceof HTMLElement && active.matches('.idea-list, .todo-list')) {
        active.blur();
      }
    };
    resetBoardFocus();
    window.addEventListener('pageshow', resetBoardFocus);
  </script>
</BaseLayout>
