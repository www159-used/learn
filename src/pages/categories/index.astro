---
import { getCollection } from 'astro:content';
import { categories, categorySlugs } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = await getCollection('notes');
const categoryList = categories.map((category) => ({
  title: category,
  slug: categorySlugs[category],
  count: notes.filter((note) => note.data.category === category).length,
}));
---

<BaseLayout title="分类">
  <h1>分类</h1>
  <p class="page-date">按主题浏览笔记</p>
  <ul class="collection-list">
    {
      categoryList.map((category) => (
        <li>
          <a href={`/categories/${category.slug}/`}>{category.title}</a>
          <span>{category.count} 篇</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
