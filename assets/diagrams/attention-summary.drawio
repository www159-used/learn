<mxfile host="Electron" agent="Cursor">
  <diagram id="attention-summary" name="Attention Summary">
    <mxGraphModel dx="820" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="396" y="25" as="geometry" />
        </mxCell>
        <mxCell id="input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="输入文本&#xa;我的名字是" vertex="1">
          <mxGeometry height="70" width="300" x="260" y="70" as="geometry" />
        </mxCell>
        <mxCell id="vectorize" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="1. 自然语言向量化&#xa;tokens / 输入 X" vertex="1">
          <mxGeometry height="90" width="300" x="260" y="180" as="geometry" />
        </mxCell>
        <mxCell id="prefill" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="2. Prefill&#xa;整段 token 并行计算&#xa;Attention + MLP&#xa;建立 KV Cache" vertex="1">
          <mxGeometry height="130" width="300" x="260" y="320" as="geometry" />
        </mxCell>
        <mxCell id="decode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="3. Decode&#xa;逐 token 计算&#xa;读取并追加 KV Cache&#xa;Attention + MLP" vertex="1">
          <mxGeometry height="130" width="300" x="260" y="520" as="geometry" />
        </mxCell>
        <mxCell id="lm-head" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="LM Head&#xa;hidden state → logits → token" vertex="1">
          <mxGeometry height="100" width="300" x="260" y="720" as="geometry" />
        </mxCell>
        <mxCell id="eof-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#000000;" value="&lt;EOF&gt;?" vertex="1">
          <mxGeometry height="120" width="120" x="350" y="860" as="geometry" />
        </mxCell>
        <mxCell id="stop" parent="1" style="shape=doubleEllipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#000000;" value="&lt;EOF&gt;&#xa;停机" vertex="1">
          <mxGeometry height="70" width="150" x="335" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="e-start-input" edge="1" parent="1" source="start" target="input" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-input-vectorize" edge="1" parent="1" source="input" target="vectorize" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-vectorize-prefill" edge="1" parent="1" source="vectorize" target="prefill" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-prefill-decode" edge="1" parent="1" source="prefill" target="decode" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-decode-lm-head" edge="1" parent="1" source="decode" target="lm-head" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-lm-head-eof" edge="1" parent="1" source="lm-head" target="eof-check" value="得到 token" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-eof-stop" edge="1" parent="1" source="eof-check" target="stop" value="是" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-next-token" edge="1" parent="1" source="eof-check" target="decode" value="否：下一轮输入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#000000;fontSize=12;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="920" />
              <mxPoint x="700" y="585" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
