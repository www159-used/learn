<mxfile host="Electron" agent="Cursor">
  <diagram id="attention-inference-states" name="Attention Inference States">
    <mxGraphModel dx="800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="436" y="35" as="geometry" />
        </mxCell>
        <mxCell id="vectorize" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="1. 自然语言向量化&#xa;输入：我的名字是&#xa;tokens：[我的，名字，是]&#xa;得到输入 X" vertex="1">
          <mxGeometry height="130" width="300" x="300" y="90" as="geometry" />
        </mxCell>
        <mxCell id="prefill" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="2. Prefill&#xa;整段 token 并行计算&#xa;Q / K / V + causal mask&#xa;建立 KV Cache" vertex="1">
          <mxGeometry height="130" width="316" x="292" y="300" as="geometry" />
        </mxCell>
        <mxCell id="decoder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontStyle=1;fontSize=15;fontColor=#000000;" value="3. Decoder&#xa;读取 KV Cache&#xa;生成下一个 token" vertex="1">
          <mxGeometry height="130" width="316" x="292" y="510" as="geometry" />
        </mxCell>
        <mxCell id="stop" parent="1" style="shape=doubleEllipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#000000;" value="&lt;EOF&gt;&#xa;停机" vertex="1">
          <mxGeometry height="70" width="145" x="377" y="760" as="geometry" />
        </mxCell>
        <mxCell id="e-start-vectorize" edge="1" parent="1" source="start" target="vectorize" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-vectorize-prefill" edge="1" parent="1" source="vectorize" target="prefill" value="得到 X" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#000000;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-prefill-decoder" edge="1" parent="1" source="prefill" target="decoder" value="KV Cache 就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#000000;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-decoder-loop" edge="1" parent="1" source="decoder" target="decoder" value="继续生成&#xa;token ≠ &lt;EOF&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#000000;fontSize=12;exitX=1;exitY=0.3;entryX=1;entryY=0.7;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="550" />
              <mxPoint x="760" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-decoder-stop" edge="1" parent="1" source="decoder" target="stop" value="生成 &lt;EOF&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#000000;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
